# /etc/clipboardx-sync/caddy.env — root only (install.sh makes it 0600):
# the AccessKey can change the domain's DNS records.
#
# The server is at https://<SYNC_NAME>.<SYNC_ZONE>:<SYNC_PORT>, e.g.
# https://sync.example.com:8443. The router forwards SYNC_PORT (TCP) to
# this machine.
SYNC_ZONE=example.com
SYNC_NAME=sync
SYNC_PORT=8443

# A RAM user of Alibaba Cloud with AliyunDNSFullAccess only.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
