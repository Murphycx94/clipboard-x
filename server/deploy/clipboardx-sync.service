[Unit]
Description=ClipboardX sync server (ciphertext only)
After=network.target

[Service]
EnvironmentFile=/etc/clipboardx-sync.env
Environment=CLIPBOARDX_SYNC_DATA=/var/lib/clipboardx-sync
ExecStart=/usr/local/bin/clipboardx-sync-server
User=clipboardx-sync
Group=clipboardx-sync
StateDirectory=clipboardx-sync
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictSUIDSGID=true
RestrictRealtime=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
UMask=0077
# Only Caddy, on this machine, talks to it.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
